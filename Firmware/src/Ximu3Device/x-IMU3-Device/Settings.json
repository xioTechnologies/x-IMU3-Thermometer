{
    "includes": [
        "<stdbool.h>",
        "<stdint.h>"
    ],
    "settings": [
        {
            "name": "Model",
            "declaration": "char name[32]",
            "default": "{\"x-IMU3\"}",
            "preserved": true
        },
        {
            "name": "Serial Number",
            "declaration": "char name[32]",
            "default": "{\"Unknown\"}",
            "preserved": true
        },
        {
            "name": "Hardware Version",
            "declaration": "char name[32]",
            "default": "{\"Unknown\"}",
            "preserved": true
        },
        {
            "name": "Firmware Version",
            "declaration": "char name[32]",
            "default": "{\"Unknown\"}",
            "read-only": true
        },
        {
            "name": "Device Name",
            "declaration": "char name[32]",
            "default": "{\"My x-IMU3\"}"
        },
        {
            "name": "Serial Enabled",
            "declaration": "bool name",
            "default": "{true}"
        },
        {
            "name": "Serial Baud Rate",
            "declaration": "uint32_t name",
            "default": "{115200}"
        },
        {
            "name": "Serial RTS/CTS Enabled",
            "declaration": "bool name",
            "default": "{false}"
        },
        {
            "name": "Binary Mode Enabled",
            "declaration": "bool name",
            "default": "{true}"
        },
        {
            "name": "USB Data Messages Enabled",
            "declaration": "bool name",
            "default": "{true}"
        },
        {
            "name": "Serial Data Messages Enabled",
            "declaration": "bool name",
            "default": "{true}"
        },
        {
            "name": "Example Float",
            "declaration": "float name",
            "default": "{1.0f}"
        }
    ]
}